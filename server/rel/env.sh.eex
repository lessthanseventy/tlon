#!/bin/sh
# Sourced by EVERY `bin/funes` subcommand — start, remote, rpc, stop — so the
# service and the operator's console agree on node name and cookie by construction.
# One source of truth: never set the node/cookie in the systemd unit AND here.
#
# `name` + loopback so `bin/funes remote`/`rpc` attach reliably without depending on
# hostname resolution. Distribution binds no further than the machine anyway (the MCP
# listener is 127.0.0.1-only); the cookie is the release-generated `releases/COOKIE`,
# shared by every subcommand of the same build — not a funes identity secret, just the
# BEAM's loopback IPC handshake on a single-user box. `funes:restart` rebuilds and
# restarts together, so the cookie can't desync.
export RELEASE_DISTRIBUTION=name
export RELEASE_NODE=funes@127.0.0.1
