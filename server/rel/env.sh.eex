#!/bin/sh
# Sourced by EVERY `bin/server` subcommand — start, remote, rpc, stop — so the
# service and the operator's remote shell agree on node name and cookie by construction.
# One source of truth: never set the node/cookie in the systemd unit AND here.
#
# `name` + loopback so `bin/server remote`/`rpc` attach reliably without depending on
# hostname resolution. Distribution binds no further than the machine anyway (the MCP
# listener is 127.0.0.1-only); the cookie is the release-generated `releases/COOKIE`,
# shared by every subcommand of the same build — not a funes identity secret, just the
# BEAM's loopback IPC handshake on a single-user box. `server:restart` rebuilds and
# restarts together, so the cookie can't desync.
export RELEASE_DISTRIBUTION=name
# TLON_NODE names another node of this release beside the service (release:smoke's scratch one).
export RELEASE_NODE="${TLON_NODE:-funes@127.0.0.1}"
# Another node on this machine (`mise run server:dev`) cannot read the release-generated cookie in
# the nix store, so both sides read ONE file, ~/.local/share/tlon/cookie (home-manager writes it once; TLON_COOKIE_FILE overrides). An
# explicit RELEASE_COOKIE still wins; with neither, the release's own COOKIE applies as before.
: "${TLON_COOKIE_FILE:=$HOME/.local/share/tlon/cookie}"
if [ -z "${RELEASE_COOKIE:-}" ] && [ -r "$TLON_COOKIE_FILE" ]; then
  RELEASE_COOKIE="$(tr -d '[:space:]' < "$TLON_COOKIE_FILE")"
  export RELEASE_COOKIE
fi
