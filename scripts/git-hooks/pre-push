#!/usr/bin/env bash
# Branch fencing, push side (see pre-commit): a pane with TLON_THREAD pushes nothing itself. Its
# thread's branch reaches GitHub only through the server's `push_branch` tool, which pushes that
# one branch (force-with-lease) and never main. A human terminal has no TLON_THREAD and is
# unaffected; the server's own pushes (the merge queue's publish) run without one.
set -u
[ -n "${TLON_THREAD:-}" ] || exit 0
echo "tlon: refusing to push from thread #$TLON_THREAD — call the push_branch tool: the server pushes your thread's own work/<slug> branch (force-with-lease) for you." >&2
exit 1
