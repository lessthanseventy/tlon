# Nothing here is generated yet, but the rule is set now: a machine-written file is
# regenerated wholesale and never hand-edited, so a build or state directory would be
# a second source of truth the moment it appeared.

node_modules/
.dev/
.DS_Store

# elixir / mix
_build/
deps/
*.beam
*.ez
erl_crash.dump
.elixir_ls/
*.sqlite
*.sqlite-wal
*.sqlite-shm

# AGENTS.md is in ~/.gitignore_global, which is right for most repos and wrong for this one: here it is
# part of the deliverable, because the spec's §7 leans on it to make "knows nothing" safe. Re-included
# explicitly rather than force-added, so the exception is visible in the tree rather than remembered.
#
# Found the way the other two were: `git add` reported nothing and committed nothing. That is the third
# file today that was invisible to git while every status looked clean -- the spec (swallowed by
# /.config/* in workbench-env), its review, and this. Ask check-ignore, not status.
!AGENTS.md

# .claude/ is ignored by ~/.gitignore_global (right for most repos, wrong here): this repo's
# sandbox + permission posture is a declared, version-controlled part of the machine, so
# settings.json travels with the tree. Re-include the directory (the global rule excludes it
# whole), re-ignore its contents, then re-include only settings.json — settings.local.json and
# anything else transient stays out. Same "visible exception, not remembered" rule as AGENTS.md.
!.claude/
.claude/*
!.claude/settings.json

# nix build output symlinks
result
result-*

# the per-world MCP token signing key (Funes.MCP.Secret) — a local credential, never committed
*.token_secret

# cap.sh capture logs — transient, read-then-discard
.logs/

# Live session handoff (not repo content) — see the memory files for durable state
HANDOFF.md

# git worktrees (superpowers isolated workspaces)
.worktrees/

# local statusline / powerline configs (not repo artifacts)
/cfg.json
/cfg-*.json

# console hot-reload trigger (console:reload)
console/.reload

# .omc/ — local tool runtime state (sessions, last-tool-error.json); never repo content
.omc/
