{
  "mcpServers": {
    "funes": {
      "url": "${FUNES_MCP_URL}",
      "headers": { "Authorization": "!/absolute/path/to/scripts/tlon-cli.sh bearer" },
      "directTools": ["post_message", "bank_fact", "raise_issue", "record_done", "get_dossier", "consult_peer"],
      "excludeTools": ["register"]
    }
  }
}
